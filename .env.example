# Public URL of this Next.js app (used later for auth redirects / CORS docs)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Express API base URL — used when we wire the API client (later phase)
NEXT_PUBLIC_API_URL=http://localhost:4000

# Customer-facing product name in the UI (internal repo name stays SecureVault)
NEXT_PUBLIC_APP_NAME=Secrela
